{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JWT": {
    "Audience": "QuizKit.Apps",
    "Issuer": "QuizKit.Users",
    "SecretKey": "{Provide-Actual-Key-In-Env-Variables-From-Vault}"
  },
  "AllowedHosts": "*",
  "UserPolicy": {
    "SessionTimeout": 30,
    "PasswordTokenTimeout": 5,
    "EmailVerificationTimeout": 30,
    "EnableLockout": true,
    "MaxPasswordFailCount": 5,
    "PasswordLockoutDuration": 30,
    "InviteExpiryHours": 72,
    "MinPasswordLength": 8,
    "MaxPasswordLength": 64,
    "AuthenticationScheme": "Bearer"
  }
}
